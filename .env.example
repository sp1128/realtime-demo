# 把这个文件复制一份，改名为 .env，填上自己的密钥。
# 复制命令（在项目目录下执行）：cp .env.example .env
#
# 架构是三段级联：火山流式ASR → DeepSeek流式LLM → 火山流式TTS。
# 三段都是国内服务，默认直连。不要开系统级全局代理，否则国内流量绕出境会白搭几百毫秒。
# 配完先跑 npm run check-proxy，它会分别体检这两条路。

# ============ 必填 ============

# 火山引擎语音。控制台 console.volcengine.com →「语音技术」里拿，ASR 和 TTS 共用一对
VOLC_APP_ID=你的AppID
VOLC_ACCESS_TOKEN=你的AccessToken

# DeepSeek，只用来跑 LLM。密钥在 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥填在这里


# ============ 火山资源号 ============
# 要跟你实际开通的套餐对上，填错会在 WebSocket 握手阶段就被拒。
# 两种拒法含义不同，据此判断该改哪儿：
#   400 = 这个资源号根本不存在（多半是 1.0/2.0 的写法搞混了）
#   403 = 号是对的，但你没开通这个套餐
#
# ⚠️ 1.0 和 2.0 是两套完全不同的写法，不能互换：
#   ASR 2.0（豆包流式语音识别模型2.0）小时版 volc.seedasr.sauc.duration
#                                     并发版 volc.seedasr.sauc.concurrent
#   ASR 1.0                           小时版 volc.bigasr.sauc.duration
#   TTS 2.0（豆包语音合成模型2.0）     seed-tts-2.0
#   TTS 2.0 声音复刻                   seed-icl-2.0
#   TTS 1.0                           volc.service_type.10029
#
# 另外 ASR 2.0 只在 /api/v3/sauc/bigmodel_async 这条地址上工作
# （代码里已经写死），老的 /bigmodel 会直接 400。
# VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0


# ============ 音色与语速 ============
# 音色 ID 在控制台的「音色详情」表格里，复制 Voice_type 那一列。
#
# ⚠️ 音色和模型版本是绑死的。2.0 的音色是 _uranus_bigtts 结尾或 saturn_ 开头，
# 老的 _moon_bigtts / _mars_bigtts 那批拿到 seed-tts-2.0 上用会失败。
#
# 这里只是**默认值**：页面上的音色下拉框会覆盖它，选过一次就记在浏览器里。
# 所以平时直接在页面上挑就行，这行留着是给不带界面的场景用的。
# 电话销售场景建议自己试几个再定——音色对信任感的影响比话术还大
# VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts

# 语速偏移，0 是原速，负数更慢更沉稳。范围大致 -50 ~ 100
# VOLC_TTS_SPEECH_RATE=-5


# ============ LLM ============
# 换模型只改这一行。默认 deepseek-chat（非思考，适合电话）。
# 要更强推理可改 deepseek-reasoner，但首字会慢很多
# LLM_MODEL=deepseek-chat
# 单轮输出上限。兜底闸门，主要还得靠提示词约束。300 大约够 2~3 句中文
# MAX_OUTPUT_TOKENS=220
# 越高越活泛，越低越守话术。电话销售 0.7~0.9 之间比较合适
# LLM_TEMPERATURE=0.8
# 保留最近几轮对话。越长首 token 越慢，电话不需要记住二十分钟前的细节
# HISTORY_TURNS=12

# 提示词整个换掉可以用这个（不填就用 lib/prompt.js 里那份）。
# 平时直接改 lib/prompt.js 更方便，这里适合临时切一套话术做 A/B
# AGENT_INSTRUCTIONS=


# ============ 轮次判断 ============
# 静音多久算客户说完。小了客户喘口气就被抢白，大了接话发木
# VAD_SILENCE_MS=300

# 判定"有人在说话"需要超过噪声底的多少倍。
# 噪声底是自己长出来的（空调、风扇这类稳态噪声会被自动吸收），一般不用动。
# 环境嘈杂、AI 老是被杂音触发时往上调到 3.5~5
# VAD_RATIO=2.6

# 静音之后再等一下才提交，让 ASR 最后一段结果落地。
# 调小会丢掉客户最后两三个字，调大接话变慢
# COMMIT_DELAY_MS=150

# ASR 内部静音多久把这一句定稿（二遍识别也在这时跑）。跟上面的 VAD 对齐比较稳
# ASR_END_WINDOW_MS=400


# ============ 打断 ============
# 走的是「确认式打断」：VAD 一响先按住播放、停止给 TTS 喂新句子，
# 但不立刻销毁——等 ASR 真吐出字来才确认。这样咳嗽、纸响、
# AI 自己从声卡回环漏回来的声音都打不断它。

# 最多等多久去确认。超时没听到字就当误报，把话接着说完
# BARGE_CONFIRM_MS=1000
# 要听到几个字才算数。设 1 容易被回声里的单字误触
# BARGE_MIN_CHARS=2

# 短于这个长度的转写不做回声比对，一律当成客户真在说话。
# 选择题抢答（「期货」「股票」）就长在 AI 正念的那句里，一比对就被吃掉。
# 调小 = 更防回声但更容易吃掉抢答；调大 = 反之
# BARGE_ECHO_MIN_CHARS=5

# AI 说话期间保留多少毫秒真音频，客户插话时补送给 ASR。
# VAD 要连续几帧才确认有人在说话，这段时间的音频已经被当静音喂掉了；
# 不补的话 ASR 从半个字开始听，很难在确认窗口内出字，插话就会被判成误报。
# 调大对识别更有利，代价是内存里多留一点音频
# PREROLL_MS=500

# 情绪 / 语速 / 音量检测。默认开，免费，只是在定稿分句上多带几个字段。
# 开了之后 LLM 每轮能拿到"客户这句比刚才快了多少"这类听感信息——
# 级联架构最大的损失就是模型只看得到文字、听不出语气，这个补一部分回来。
# 实测语速能区分（不耐烦 5.0 / 平静 3.8），情绪标签在合成语音上一直是 neutral，
# 真人语音上效果待观察。日志里会打 🎚️ 那一行，可以对着看准不准。
# ASR_EMOTION=false

# 合成模型档位（req_params.model）。留空就不发，用服务端默认值。
# 实测只有 seed-tts-2.0-standard 合法，其它写法一律 45000001 InvalidModel。
# 注意别拿它切复刻版本——那是资源号决定的，填资源号进来会直接报错
# VOLC_TTS_MODEL=seed-tts-2.0-standard

# 语音指令：用大白话跟 TTS 说话来约束风格，比如"平稳一点""说慢一点"。
# 默认这句是冲着"同一个音色听起来像好几个人"去的。
# 实测（同句话念 8 遍 + 同配置重复组量噪声）：句间基频标准差 8.9→7.2Hz、
# 极差 30→21Hz，降幅远超 0.9Hz 的噪声。压不平但确实收窄。
# 设成空字符串关闭。仅 TTS2.0 音色支持，这段文字不计费
# VOLC_TTS_STYLE=你可以一直用同一个语气说话吗？平稳一点，不要有情绪起伏。


# ============ 转写调优 ============
# 通话里会出现的人名、公司名、行话、缩写，逗号分隔。
# 这个对准确率的提升最直接，值得花时间填。
# 注意火山对热词总量有限制（约 100 tokens），超了会从后往前截断，
# 所以要挑真正容易听错的词，不是越多越好
# ASR_HOTWORDS=张伟,李娜,报价单,交期,佐藤商事


# ============ 开场 ============
# 接通后由 AI 先开口（外呼场景需要）。填 false 则等客户先说话
# AUTO_GREET=true
# 等一下再开口，避免开场头两个字在声卡还没准备好时被切掉
# GREET_DELAY_MS=400

# 说完后客户一直不接话：先追问一句，再还不说话就道别并结束通话
# IDLE_NUDGE_MS=4000
# IDLE_BYE_MS=10000

# 客户称呼。用在两处：开场没人应时那句「喂，X先生，能听到吗」，
# 以及锁住开场白里的姓名——放开措辞之后模型会连姓名一起"创作"，
# 实测编出过张先生、陈先生。不填就从提示词的开场示例里抠（现在是叶升辉）
# CUSTOMER_NAME=叶升辉

# 追问生成的等待上限。超了就用固定句，冷场已经够久不能再干等
# NUDGE_TIMEOUT_MS=1500

# LLM 超过这么久还没吐字就先垫半个字。默认 0（关闭）。
# 实测在火山 TTS 上行不通：它不足 5 个字不开始合成，短垫话自己就要卡到正文
# 到达才出声；改用够长的垫话又会在垫话播完到正文之间留出几百毫秒空白。
# FILLER_MS=0

# 把每次发给火山 TTS 的请求参数打到服务端控制台。默认开。
# StartSession 打完整 req_params（additions 已还原成对象，不是转义字符串），
# TaskRequest 打送进去的文本。排查音色/韵律问题时要看的就是这些。
# 嫌刷屏就设 false
# TTS_LOG_REQUEST=false


# ============ 局域网 HTTPS（手机同一 WiFi）============
# 手机浏览器只给 https 页面麦克风。电脑本机仍用 http://localhost:3000。
# HTTPS_PORT=3443


# ============ 代理 ============
# 三段都是国内服务，默认直连。只有访问不了 api.deepseek.com 时才需要。
# Clash 默认 7890，V2Ray 默认 10809。
# 代理要认证的话写成 http://用户名:密码@127.0.0.1:7890
#
# ⚠️ 注意别开系统级全局代理：火山和 DeepSeek 都会被绕出境，
# 延迟从 20ms 变成 300ms，而且完全不报错，只是每句话都慢。
# npm run check-proxy 会把这种情况直接指出来。
# HTTPS_PROXY=http://127.0.0.1:7890
